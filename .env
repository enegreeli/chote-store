# ========================================================
# BANCO DE DADOS ATIVO
# ========================================================
# Padrão local (SQLite - funciona sem nenhuma configuração externa):
DATABASE_URL="file:./dev.db"

# ========================================================
# CONEXÃO COM O SUPABASE (PostgreSQL)
# ========================================================
# Para conectar ao seu Supabase existente:
# 1. Copie a Connection String no painel do Supabase:
#    (Project Settings -> Database -> Connection string -> URI)
# 2. Descomente a linha abaixo e cole a sua URL:
# DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# Credenciais da API do Supabase (para Storage de Fotos e Auth caso deseje):
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-do-supabase"

# ========================================================
# SEGREDOS DA APLICAÇÃO
# ========================================================
JWT_SECRET="chote-store-super-secure-jwt-secret-key-2025"
NEXT_PUBLIC_STORE_NAME="CHOTE KITS | Premium Football Store"
